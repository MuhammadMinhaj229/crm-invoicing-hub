# Safar Studio environment template. Never commit populated environment files.
# Only the Supabase URL and anon key are intended for the browser bundle.
# Configure both variables in BOTH Vercel projects after production DB validation.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# One-time seed bootstrap only. Server/local shell variables; NEVER add a VITE_ prefix.
# Do not configure SUPABASE_SERVICE_ROLE_KEY in either public/browser build.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, server-only inbound webhook storage. Use a least-privilege DB role.
# Direct Postgres access bypasses Supabase RLS and must never be exposed via VITE_.
DATABASE_URL=

# Meta WhatsApp Cloud webhook verification (only when that integration is enabled).
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Evolution webhook header secret (only when that integration is enabled).
# Provider must send it in x-webhook-secret; query-string secrets are rejected.
WHATSAPP_WEBHOOK_SECRET=
