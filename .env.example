# SAFAR N MANZIL — server settings
# Copy this file to .env (local) or paste the values into your hosting
# provider's environment settings. Never commit real keys.

# ---- Database (your own Supabase project) ----
# The team console can also take these in Settings > Connections.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Used by the WhatsApp webhook to write incoming messages.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp: your own server (Evolution API) ----
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ---- WhatsApp: official Meta Cloud API (optional) ----
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Shared secret checked on every incoming message webhook.
WHATSAPP_WEBHOOK_SECRET=

# ---- Social accounts (optional, official APIs only) ----
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
GBP_TOKEN=
GBP_ACCOUNT_ID=
LINKEDIN_TOKEN=
LINKEDIN_ORG_ID=
YOUTUBE_TOKEN=
YOUTUBE_CHANNEL_ID=
